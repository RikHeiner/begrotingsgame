# Kopieer naar .env.local en vul in (zie docs/SUPABASE-INSTELLEN.md en docs/LANCERING.md).

# Het adres van de site, voor de Open Graph-tags (de afbeelding bij een gedeelde link).
VITE_SITE_URL=https://jouw-domein.nl

# De anon key is openbaar: hij komt in de browser. De database beschermt zich met row level security.
VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Zonder Supabase: inzendingen in de browser opslaan (alleen voor demo en tests).
# VITE_OPSLAG=lokaal
