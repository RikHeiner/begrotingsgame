{
  "name": "begrotingsgame",
  "private": true,
  "version": "0.0.1",
  "description": "Begrotingsgame van de gemeente Groningen: maak je eigen tegenbegroting.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:check": "tsx scripts/data-check.ts",
    "data:diff": "tsx scripts/data-diff.ts",
    "vvd:check": "tsx scripts/vvd-check.ts",
    "vvd:word": "tsx scripts/vvd-word.ts",
    "db:test": "bash scripts/db-test.sh",
    "personas:overzicht": "tsx scripts/personas-overzicht.ts",
    "geluiden": "node scripts/maak-geluiden.mjs",
    "iconen": "tsx scripts/maak-iconen.ts",
    "og": "tsx scripts/maak-og.ts",
    "bedragen:controle": "tsx scripts/bedragen-controle.ts"
  },
  "dependencies": {
    "@fontsource/asap": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "d3-geo": "^3.1.1",
    "docx": "^9.8.1",
    "howler": "^2.2.4",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jszip": "^3.10.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
